# Google Sheet (chỉ dùng trong script sync / GitHub Actions, không đưa vào frontend)
SHEET_ID=
SHEET_RANGE=A1:Z1000
GOOGLE_SERVICE_ACCOUNT_JSON=
# hoặc đường dẫn file key:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Mật khẩu đăng nhập (dùng để mã hoá file data.enc).
# BẮT BUỘC khi đồng bộ Sheet thật. Dùng mật khẩu dài, khó đoán: ai tải data.enc về đều có thể thử dò mật khẩu.
# Để trống khi chạy dữ liệu mẫu → dùng mật khẩu mẫu "a1-class".
APP_PASSWORD=

# true = bắt buộc login; false = public, ghi data.json không mã hoá
VITE_REQUIRE_AUTH=true
REQUIRE_AUTH=true

# Nếu repo GitHub Pages dạng /<ten-repo>/ thì đặt ví dụ /calendar-a1-class/
VITE_BASE=./
